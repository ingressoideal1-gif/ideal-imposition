rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    // Verifica se o usuário tem um determinado papel no projeto
    function hasRole(projectId, role) {
      return exists(/databases/$(database)/documents/userRoles/$(request.auth.uid + '_' + projectId)) &&
             get(/databases/$(database)/documents/userRoles/$(request.auth.uid + '_' + projectId)).data.role == role;
    }

    function isAdmin(projectId) { return hasRole(projectId, 'admin'); }
    function isEditor(projectId) { return hasRole(projectId, 'editor'); }
    function canWrite(projectId) { return isAdmin(projectId) || isEditor(projectId); }

    // ── Teste de conexão silencioso ───────────────────────────────────────────
    match /_conn_test/{doc} {
      allow read: if request.auth != null;
    }

    // ── Projetos dos usuários ─────────────────────────────────────────────────
    match /users/{userId}/projects/{projectId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Arquivos da biblioteca de mídia ───────────────────────────────────────
    match /files/{fileId} {
      // Leitura: qualquer autenticado
      allow read: if request.auth != null;

      // Upload: qualquer usuário autenticado
      allow create: if request.auth != null;

      // Atualização: próprio usuário OU Admin do projeto
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.userId
                        || isAdmin(resource.data.projectId));

      // Exclusão: próprio usuário que fez upload OU Admin do projeto
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.userId
                        || isAdmin(resource.data.projectId));
    }

    // ── Categorias da biblioteca de mídia ────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      
      // Criação de categorias: qualquer usuário autenticado
      allow create: if request.auth != null;
                    
      allow update, delete: if request.auth != null
                            && (request.auth.uid == resource.data.userId
                                || isAdmin(resource.data.projectId));
    }

    // ── Papéis de usuários por projeto ───────────────────────────────────────
    match /userRoles/{roleId} {
      // Leitura: o próprio usuário pode ver seu papel, Admins veem todos
      allow read: if request.auth != null
                  && (resource == null
                      || request.auth.uid == resource.data.userId
                      || isAdmin(resource.data.projectId));

      // Criação: Admin do projeto pode adicionar; o primeiro usuário cria como Admin
      allow create: if request.auth != null;

      // Atualização de papel: apenas Admin do projeto
      allow update: if request.auth != null
                    && isAdmin(resource.data.projectId);

      // Remoção: apenas Admin do projeto (não pode remover a si mesmo)
      allow delete: if request.auth != null
                    && isAdmin(resource.data.projectId)
                    && request.auth.uid != resource.data.userId;
    }
  }
}
